// --- Simülasyon Değişkenleri ---
uint32_t sim_packet_counter = 1;
float sim_altitude = 2000.0f;
float sim_elapsed_time = 0.0f;
float sim_lat = 41.0283f;
float sim_lon = 28.8890f;
float sim_pitch = 0.0f, sim_roll = 0.0f, sim_yaw = 0.0f;

// CRC-8 Hesaplama (Polinom: 0x07)
uint8_t CalculateCRC8(uint8_t *data, uint16_t length) {
    uint8_t crc = 0x00;
    for (uint16_t i = 0; i < length; i++) {
        crc ^= data[i];
        for (uint8_t j = 0; j < 8; j++) {
            if (crc & 0x80)
                crc = (crc << 1) ^ 0x07;
            else
                crc <<= 1;
        }
    }
    return crc;
}

// Simülasyon adımını çalıştırıp paketi oluşturur
void SimulateAndBuildPacket(TelemetriPaketi_t *pkt) {
    sim_elapsed_time += 1.0f;
    
    // Yükseklik ve hız
    float descentRate = 12.5f;
    if (sim_altitude > 0) {
        sim_altitude -= descentRate;
    }
    if (sim_altitude < 0) sim_altitude = 0.0f;
    
    // Paket doldurma
    pkt->header = 0xAB;
    pkt->paket_no = sim_packet_counter++;
    
    if (sim_altitude <= 0) pkt->uydu_statusu = 4;
    else if (sim_altitude < 100) pkt->uydu_statusu = 3;
    else pkt->uydu_statusu = 2;
    
    // Hata kodunu varsayılan 0000 yapalım
    memcpy(pkt->hata_kodu, "0000", 4);
    
    // Saat (Mock)
    snprintf(pkt->gonderme_saati, 20, "01/08/2026 15:30:00");
    
    // Basınç (Barometrik formül)
    pkt->basinc = 101325.0f * powf((1.0f - (0.0065f * sim_altitude) / 288.15f), 5.255f);
    pkt->yukseklik = sim_altitude;
    pkt->inis_hizi = (sim_altitude <= 0) ? 0.0f : (12.5f + sinf(sim_elapsed_time * 0.1f) * 0.5f);
    
    pkt->sicaklik = 25.0f - ((sim_altitude / 1000.0f) * 6.5f);
    
    float voltage = 7.6f - (sim_elapsed_time * 0.01f);
    pkt->pil_gerilimi = (voltage < 0.0f) ? 0.0f : voltage;
    
    // Basit GPS Hareketi (Hedefe doğru)
    float targetLat = 41.0250f;
    float targetLon = 28.8920f;
    sim_lat += (targetLat - sim_lat) * 0.05f;
    sim_lon += (targetLon - sim_lon) * 0.05f;
    pkt->gps_latitude = sim_lat;
    pkt->gps_longitude = sim_lon;
    pkt->gps_altitude = sim_altitude + 2.0f;
    
    // Eksen salınımları
    sim_pitch = sinf(sim_elapsed_time * 0.3f) * 15.0f;
    sim_roll = sinf(sim_elapsed_time * 0.25f + 1.04f) * 10.0f;
    sim_yaw = fmodf((sim_elapsed_time * 5.0f), 360.0f);
    
    pkt->pitch = sim_pitch;
    pkt->roll = sim_roll;
    pkt->yaw = sim_yaw;
    pkt->takim_no = 12345;
    
    // CRC Hesaplama (Son byte hariç tüm byte'lar)
    pkt->crc = CalculateCRC8((uint8_t*)pkt, sizeof(TelemetriPaketi_t) - 1);
}

